    {
      "name": "List all tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "pm.test(\"Returns an array that contains the created task\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data).to.be.an(\"array\");",
              "    pm.expect(body.count).to.eql(body.data.length);",
              "    const ids = body.data.map(function (t) { return t.id; });",
              "    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"taskId\")));",
              "});"
            ]
          }
        }
