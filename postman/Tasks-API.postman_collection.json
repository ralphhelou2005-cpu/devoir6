    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "pm.test(\"Database is connected\", function () {",
              "    pm.expect(pm.response.json().database).to.eql(\"connected\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "const task = pm.response.json().data;",
              "pm.collectionVariables.set(\"taskId\", task.id);",
              "pm.test(\"Created task has an id and the sent title\", function () {",
              "    pm.expect(task.id).to.be.a(\"number\");",
              "    pm.expect(task.title).to.eql(\"Finish assignment 6\");",
              "});",
              "pm.test(\"Location header points to the new task\", function () {",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/tasks/\" + task.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "Creates a task and saves its id in the collection variable \"taskId\" for the next requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Finish assignment 6\",\n  \"description\": \"REST API with Express and SQLite\",\n  \"status\": \"in_progress\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2026-11-20\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
